<td class="center">
  <div id={{avatarId}}></div>
</td>
<td>
  <a href="{{html_url}}"
     data-student_id="{{id}}"
     data-course_id="{{course_id}}"
     class="roster_user_name student_context_card_trigger">{{name}}{{#if pronouns}} <i>({{pronouns}})</i>{{/if}}
</a>
  {{#if isILP}}
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M14.625 13.5H13.6327C13.3868 13.5 13.2639 13.5 13.1687 13.4355C13.0734 13.3711 13.0277 13.2569 12.9364 13.0286L12.5635 12.0964C12.4723 11.8681 12.4266 11.7539 12.3313 11.6895C12.2361 11.625 12.1132 11.625 11.8672 11.625H10.125C9.77145 11.625 9.59468 11.625 9.4848 11.5152C9.375 11.4053 9.375 11.2286 9.375 10.875V7.875M9.375 7.875V6M9.375 7.875H12.2917" stroke="#505B63" style="stroke:#505B63;stroke:color(display-p3 0.3137 0.3569 0.3882);stroke-opacity:1;" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M9.375 4.5C8.54655 4.5 7.875 3.82843 7.875 3C7.875 2.17157 8.54655 1.5 9.375 1.5C10.2035 1.5 10.875 2.17157 10.875 3C10.875 3.82843 10.2035 4.5 9.375 4.5Z" stroke="#505B63" style="stroke:#505B63;stroke:color(display-p3 0.3137 0.3569 0.3882);stroke-opacity:1;" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M7.16847 7.5C5.01551 7.85955 3.375 9.72338 3.375 11.9687C3.375 14.4713 5.41307 16.5 7.9272 16.5C9.45022 16.5 10.7986 15.7554 11.625 14.6119" stroke="#505B63" style="stroke:#505B63;stroke:color(display-p3 0.3137 0.3569 0.3882);stroke-opacity:1;" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
  {{/if}}
  {{#if isPending}}<span class="label label-info" title="{{#t "pending_acceptance_explanation"}}This user has not yet accepted the invitation to the course{{/t}}">{{#t "pending_acceptance_of_invitation"}}pending{{/t}}</span>{{/if}}
  {{#if isInactive}}<span class="label" title="{{#t}}This user is currently not able to access the course{{/t}}">{{#t}}inactive{{/t}}</span>{{/if}}
</td>
{{#if canViewLoginIdColumn}}
<td>
  {{#if canViewLoginId}}
    {{login_id}}
  {{/if}}
</td>
{{/if}}
{{#if canViewSisIdColumn}}
<td>
  {{#if canViewSisId}}
    {{sis_id}}
  {{/if}}
</td>
{{/if}}
{{#unless hideSectionsOnCourseUsersPage}}
<td data-test-id="section-column-cell">
  {{#each sections}}
  <div class="section">{{name}}</div>
  {{/each}}
</td>
{{/unless}}
<td>
  {{#each enrollments}}
  <div>{{enrollmentName role}}</div>
  {{/each}}
</td>
{{#if ENV.permissions.read_reports}}
<td>
  {{#each enrollments}}
    <div {{contextSensitiveDatetimeTitle last_activity_at }}>
      {{tEventToString last_activity_at 'short' 'tiny'}}
    </div>
  {{/each}}
</td>
<td>
  <div>{{total_activity_string}}</div>
</td>
{{/if}}
<td class="right">
  {{#ifAny canManage canRemoveUsers}}
  <div class="admin-links">
    <a role="button" class="al-trigger al-trigger-gray" href="javascript:void(0)">
      <i class="icon-more" aria-hidden="true"></i>
      <span class="screenreader-only">{{#t "manage_user"}}Manage {{name}}{{/t}}</span></a>
    <ul class="al-options">
      {{#if canManage}}
        {{#if canResendInvitation}}
          <li><a href="#" data-event="resendInvitation"><i class="icon-email" aria-hidden="true"></i> {{#t "links.resend_invitation"}}Resend Invitation{{/t}}</a></li>
        {{/if}}
        {{#if canLinkStudents}}
          <li><a href="#" data-event="linkToStudents"><i class="icon-link" aria-hidden="true"></i> {{#t "links.link_to_students"}}Link to Students{{/t}}</a></li>
        {{/if}}
        {{#if canEditSections}}
          <li><a href="#" data-event="editSections"><i class="icon-edit" aria-hidden="true"></i> {{#t "links.edit_sections"}}Edit Sections{{/t}}</a></li>
        {{/if}}
        {{#if canEditRoles}}
          <li><a href="#" data-event="editRoles"><i class="icon-edit" aria-hidden="true"></i> {{#t}}Edit Role{{/t}}</a></li>
        {{/if}}
      {{/if}}
      <li><a href="{{url}}"><i class="icon-user" aria-hidden="true"></i> {{#t "links.user_details"}}User Details{{/t}}</a></li>

      {{#if canRemoveUsers}}
        <li style="clear: left; border: none;" aria-hidden="true"><hr /></li>
        {{#if isInactive}}
          <li><a href="#" data-event="reactivateUser"><i class="icon-user" aria-hidden="true"></i>  {{#t}}Re-activate User{{/t}}</a></li>
        {{else}}
          <li><a href="#" data-event="deactivateUser"><i class="icon-deactivate-user" aria-hidden="true"></i> {{#t}}Deactivate User{{/t}}</a></li>
        {{/if}}
        <li><a href="#" data-event="removeFromCourse"><i class="icon-trash" aria-hidden="true"></i> {{#t "links.remove_from_course"}}Remove From Course{{/t}}</a></li>
      {{/if}}
      {{#each customLinks}}
        <li><a href="{{url}}"><i class="{{icon_class}}"></i> {{text}}</a></li>
      {{/each}}
    </ul>
  </div>
  {{/ifAny}}
</td>
