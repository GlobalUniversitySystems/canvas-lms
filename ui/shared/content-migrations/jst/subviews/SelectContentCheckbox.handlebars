<div class="radio">
    <label>
        <input type="radio" disabled name="selective_import" value=false>
        All content. <span style="color: red">(The option is disabled to avoid importing assignment groups. Please use the "Select specific content" option but do not import assignments.)</span>
    </label>
</div>

<div class="radio">
  <label>
    <input type="radio" name="selective_import" value=true>
    {{#t "select_specific_content"}}Select specific content{{/t}}
  </label>
</div>

